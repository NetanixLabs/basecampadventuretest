# Caddy: HTTPS certificates are automatic. Put Cloudflare in front with
# SSL mode "Full (strict)".

{
	servers {
		# The visitor's real IP: Cloudflare's CF-Connecting-IP is believed only
		# when the request really comes from Cloudflare's network (list from
		# https://www.cloudflare.com/ips/), so nobody can fake their address to
		# dodge the sign-in and form rate limits.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

www.basecampadventure.com {
	redir https://basecampadventure.com{uri} permanent
}

basecampadventure.com, admin.basecampadventure.com, my.basecampadventure.com {
	encode zstd gzip

	# Uploaded photos and videos: straight from disk, cached for a year
	# (their names change whenever the file changes).
	handle /uploads/* {
		root * /srv/basecamp
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3000 {
			# During the few seconds a deploy restarts the app, visitors wait instead of seeing an error.
			lb_try_duration 20s
			lb_try_interval 250ms
			# Overwrites anything the visitor sent; the app trusts only this.
			header_up X-Real-IP {client_ip}
		}
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/basecamp.log {
			roll_size 50mb
			roll_keep 10
		}
	}
}
