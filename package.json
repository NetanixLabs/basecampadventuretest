{
  "name": "basecamp-adventure",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "import:wp": "python scripts/import-wordpress.py",
    "photos": "python scripts/prepare-photos.py",
