# ---------------------------------------------------------------- website
# Public site address, used for canonicals, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://basecampadventure.com

# Google Analytics 4 and search engine verification.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# tawk.to live chat: Property ID and Widget ID from the tawk.to dashboard.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# ------------------------------------------------------------------ admin
# PostgreSQL connection.
DATABASE_URL=postgresql://basecamp:CHANGE_ME@localhost:5432/basecamp

# 32 random bytes, base64. Encrypts 2FA secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and never change it (2FA would have to be set up again).
ENCRYPTION_KEY=

# Admin address (used in emailed links) and the host the admin answers on.
ADMIN_URL=https://admin.basecampadventure.com
ADMIN_HOST=admin.basecampadventure.com

# Traveller portal (accounts for paid bookings) and the host it answers on.
PORTAL_URL=https://my.basecampadventure.com
PORTAL_HOST=my.basecampadventure.com
# Travellers' documents, stored encrypted. Outside the website folder.
PRIVATE_DIR=/srv/basecamp/private

# Secret for the scheduled jobs (reminders, review requests, closing old
# traveller accounts). setup-server.sh fills it in.
CRON_SECRET=

# Keep true in production: every admin account must use two-step sign-in.
REQUIRE_TOTP=true
SESSION_HOURS=72
SESSION_IDLE_MINUTES=60

# Where published content and uploaded images live on the server.
CONTENT_DIR=/srv/basecamp/content
UPLOADS_DIR=/srv/basecamp/uploads

# First owner account (used once by `npm run admin:import`).
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
# Leave empty to have a temporary password generated and printed once.
SEED_OWNER_PASSWORD=

# ------------------------------------------------------------------ email
# Any SMTP service: Google Workspace (smtp.gmail.com:587), Zoho (smtp.zoho.com:465),
# Amazon SES, Resend (smtp.resend.com:465), Brevo… Empty = emails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Base Camp Adventure <info@basecampadventure.com>"
# Where office alerts go (new enquiry, booking, payment).
OFFICE_EMAIL=info@basecampadventure.com

# --------------------------------------------------------------- payments
# WeTravel Partner API. Without a key, bookings are recorded as requests and
# the office sends the payment link.
WETRAVEL_API_KEY=
# "production" uses api.wetravel.com; anything else uses the sandbox.
WETRAVEL_ENV=sandbox
# Signing secret of the WeTravel webhook endpoint (whsec_…), from WeTravel's
# webhook settings. Webhook URL: https://basecampadventure.com/api/webhooks/wetravel
WETRAVEL_WEBHOOK_SECRET=
